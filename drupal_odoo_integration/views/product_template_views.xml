<odoo>
    <record id="view_product_template_form_drupal" model="ir.ui.view">
        <field name="name">product.template.form.drupal</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Drupal Integration">
                    <group>
                        <field name="sync_with_drupal"/>
                        <field name="drupal_id"/>
                        <button name="action_sync_to_drupal" type="object" string="Sync to Drupal" class="btn btn-primary"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>